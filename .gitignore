# Ignore python cache
__pycache__/
*.pyc

# Ignore python env
venv/

# Ignore local datasets and sqlite db
data/

# Ignore env file since it might contain localized keys
.env
.env.*
# Ignore test artifacts
.coverage
.pytest_cache/
htmlcov/

# Node / Capacitor
node_modules/
ios/App/Pods/
ios/App/build/
ios/DerivedData/
android/.gradle/
android/build/
android/app/build/
android/local.properties
.DS_Store

# Terraform local state & provider cache
terraform/.terraform/
**/.terraform/
*.tfstate
*.tfstate.*
terraform/.terraform.lock.hcl
