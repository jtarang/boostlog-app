# --- boostLog Environment Template ---
# Copy to .env.dev for local development or .env.production for prod.
# In deployed environments these values come from AWS Secrets Manager; this
# template is for running locally.

# [DATABASE]
# Local default is the SQLite fallback. For Postgres/RDS use:
#   postgresql://<user>:<pass>@<host>:5432/<db>?sslmode=require
DATABASE_URL=sqlite:///./data/boostlog.db

# [AUTHENTICATION]
SECRET_KEY=generate_a_long_random_string_here

# SSO providers (handled by fastapi-sso). Redirect URIs are built as
# {OAUTH_REDIRECT_BASE}/api/auth/{provider}/callback and must match what you
# register with each provider.
OAUTH_REDIRECT_BASE=http://localhost:8000

# GitHub — GitHub Developer Settings > OAuth Apps
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Google — Google Cloud Console > Credentials > OAuth client (Web)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Microsoft — Entra ID > App registrations. Tenant "common" allows personal
# and work/school accounts.
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT=common

# Discord — Discord Developer Portal > Applications > OAuth2
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Apple — Apple Developer > Certificates, Identifiers & Profiles.
# APPLE_CLIENT_ID is the Services ID; APPLE_PRIVATE_KEY_B64 is the .p8 key,
# base64-encoded:  base64 -i AuthKey_XXXX.p8
APPLE_CLIENT_ID=your_apple_services_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY_B64=your_base64_encoded_p8_key

# Passkeys / WebAuthn. RP_ID is the domain (no scheme); WP_ORIGIN is the full
# origin, also used as the base for password-reset links.
RP_ID=localhost
WP_ORIGIN=http://localhost:8000

# Optional: Fernet key overriding the derived key used to encrypt linked
# bootmod3 tokens. Leave unset to derive from SECRET_KEY.
# BOOTMOD3_ENC_KEY=

# [AI AGENT]
# AWS Bedrock (requires IAM permissions):
#   LLM_MODEL=bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0
#   AWS_REGION_NAME=us-east-1
# Anthropic directly:
#   LLM_MODEL=claude-3-5-sonnet-20240620
#   ANTHROPIC_API_KEY=your_key_here
# Local fallback (Ollama):
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
# Optional: return this canned string instead of calling an LLM (local/testing).
# MOCK_AI_RESPONSE=

# [PAYMENTS - STRIPE]  (Stripe Dashboard: https://dashboard.stripe.com)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRICE_ID_PRO=price_your_pro_price_id
STRIPE_PRICE_ID_TUNER=price_your_tuner_price_id

# [INFRASTRUCTURE]
# Skip fetching secrets from AWS Secrets Manager when running locally.
SKIP_AWS_FETCH=true
# Log storage: leave unset to store CSV logs on local disk (UPLOAD_DIR); set to
# an S3 bucket name to store them in S3 (needs AWS creds / EC2 role).
# LOG_BUCKET=boostlog-logs-dev
AWS_REGION=us-east-1
AWS_SECRET_NAME=boostlog.app/dev/secrets
# "development" or "production" (affects webhook behavior).
ENVIRONMENT=development

# [CLOUDFLARE]
# Consumed by the cloudflared tunnel container in docker-compose.
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token
